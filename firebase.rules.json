{
  "rules": {
    "artworks": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || auth.uid === 'UzUYv8RIPoYS2vpMXtAQeBUt09E3')"
    },
    "artworkSettings": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || auth.uid === 'UzUYv8RIPoYS2vpMXtAQeBUt09E3')"
    },
    "leaderboard": {
      ".read": true,
      "$deviceId": {
        ".write": "auth != null && ((!data.exists() && newData.child('deviceId').val() == auth.uid) || auth.uid === 'UzUYv8RIPoYS2vpMXtAQeBUt09E3' || auth.token.admin === true)"
      }
    },
    "notes": {
      ".read": true,
      "$deviceId": {
        ".write": "auth != null && (auth.uid === $deviceId || auth.uid === 'UzUYv8RIPoYS2vpMXtAQeBUt09E3' || auth.token.admin === true)"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$deviceId": {
        ".write": "auth != null && auth.uid === $deviceId"
      }
    },
    "analytics_visits": {
      ".write": "auth != null",
      ".read": "auth != null && (auth.token.admin === true || auth.uid === 'UzUYv8RIPoYS2vpMXtAQeBUt09E3')"
    },
    "arBundleCurrent": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || auth.uid === 'UzUYv8RIPoYS2vpMXtAQeBUt09E3')"
    }
  }
}